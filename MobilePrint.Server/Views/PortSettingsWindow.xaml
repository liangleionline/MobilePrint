<Window x:Class="MobilePrint.Server.Views.PortSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="端口设置" Height="200" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="监听端口:" FontSize="14" Margin="0,0,0,8"/>
        <TextBox x:Name="PortBox" FontSize="16" Height="36"/>
        <TextBlock x:Name="MsgText" Foreground="Red" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Button x:Name="SaveBtn" Content="保存并重启服务" Height="40" Margin="0,16,0,0" Background="#4CAF50" Foreground="White"/>
    </StackPanel>
</Window>
