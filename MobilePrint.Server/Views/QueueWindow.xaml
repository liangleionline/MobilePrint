<Window x:Class="MobilePrint.Server.Views.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印队列" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <ListView x:Name="QueueList" Margin="8" SelectionMode="Single"
                  ContextMenuOpening="QueueList_ContextMenuOpening">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="状态" Width="120" DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="添加时间" Width="180" DisplayMemberBinding="{Binding AddedTimeText}"/>
                    <GridViewColumn Header="任务详情" Width="260" DisplayMemberBinding="{Binding DetailText}"/>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Window>
