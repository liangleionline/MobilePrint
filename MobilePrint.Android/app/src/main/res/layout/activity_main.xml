<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="服务器地址(IP:端口):" android:textSize="14sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <EditText android:id="@+id/etServerAddr" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="192.168.1.197:8899" android:inputType="text"/>
            <Button android:id="@+id/btnTestConn" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="测试连接"
                android:layout_marginStart="8dp" android:backgroundTint="#2196F3"/>
        </LinearLayout>
        <TextView android:id="@+id/tvConnStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="未连接" android:textSize="12sp"
            android:textColor="#999" android:layout_marginTop="4dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Token:" android:textSize="14sp" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/etToken" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="123456" android:inputType="text"/>

        <Button android:id="@+id/btnSelectFile" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="选择文件" android:layout_marginTop="12dp"
            android:enabled="false"/>
        <TextView android:id="@+id/tvFileName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="未选择文件" android:layout_marginTop="4dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="份数:" android:layout_marginEnd="8dp"/>
            <EditText android:id="@+id/etCopies" android:layout_width="80dp"
                android:layout_height="wrap_content" android:text="1" android:inputType="number"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="方向:" android:layout_marginStart="16dp" android:layout_marginEnd="8dp"/>
            <Spinner android:id="@+id/spOrientation" android:layout_width="100dp"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="页码范围(空=全部, 如1,3,5-7):" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/etPageRange" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="全部" android:inputType="text"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="边距(mm):" android:layout_marginEnd="8dp"/>
            <EditText android:id="@+id/etMargin" android:layout_width="80dp"
                android:layout_height="wrap_content" android:text="10" android:inputType="number"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="缩放:" android:layout_marginStart="16dp" android:layout_marginEnd="8dp"/>
            <Spinner android:id="@+id/spScaleMode" android:layout_width="120dp"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <Switch android:id="@+id/swCompress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="图片压缩上传"
            android:checked="true" android:layout_marginTop="8dp"/>

        <Button android:id="@+id/btnPrint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="打印"
            android:layout_marginTop="12dp" android:backgroundTint="#4CAF50"
            android:enabled="false"/>

        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="" android:layout_marginTop="8dp"
            android:textSize="14sp"/>

        <Button android:id="@+id/btnViewLog" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="查看日志"
            android:layout_marginTop="24dp" android:backgroundTint="#607D8B"/>
    </LinearLayout>
</ScrollView>
